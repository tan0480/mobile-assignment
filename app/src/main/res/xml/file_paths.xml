<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Where "Take Photo" camera captures write their temp files to, before being handed off as
         a content:// Uri (see AddPhotoTile/createCameraCaptureUri in screen/components/PhotoPicker.kt).
         One entry per feature's cameraSubDir — a subdir not listed here makes FileProvider throw. -->
