<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only used for the location picker's optional "use my current location" button —
         the picker still works (falling back to a fixed map center) if this is denied. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Required on API 33+ to show any notification. Requested upfront on app start
         (see RequestStartupPermissions) even though nothing posts a system notification
         yet, so it's ready for whenever that lands. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GadgetMover">

        <!-- Populated from local.properties' MAPS_API_KEY via the manifestPlaceholders entry
             in app/build.gradle.kts — never hardcoded here. Empty until that key is set, in
             which case the map picker simply won't render tiles (no crash). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.GadgetMover">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Product detail deep link (shared via ProductDetailScreen's Share action, e.g.
                 https://gadgetmover.app/product/{id}) — matched against Screen.ProductDetail's
                 navDeepLink in NavGraph.kt. android:autoVerify requires a Digital Asset Links
                 file hosted at https://gadgetmover.app/.well-known/assetlinks.json to make this
                 an actual verified App Link; until that's hosted, Android will still offer this
                 app in the chooser for matching links, just not auto-open it. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="gadgetmover.app"
                    android:pathPrefix="/product" />
            </intent-filter>
        </activity>

        <!-- Stripe's own card-entry screen (PaymentSheet) is a separate Activity declared in the
             Stripe SDK's manifest with no windowSoftInputMode of its own. adjustResize made every
             focus switch between fields (which likely toggles the IME between numeric/text
             keyboards per field) physically resize the whole screen, which is what looked like a
             "jump" on every tap. adjustPan instead pans the existing layout instead of resizing
             it, so a keyboard-type toggle between fields shouldn't visibly collapse the screen. -->
        <activity
            android:name="com.stripe.android.paymentsheet.PaymentSheetActivity"
            android:windowSoftInputMode="adjustPan"
            tools:node="merge" />

        <!-- Hands a content:// Uri to the system Camera app for the listing wizard's "Take Photo"
             option (see ListingWizardScreen.kt's StepPhotos) — the Camera app can't write to a
             plain file:// path on modern Android, so it needs this instead. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
